<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>Trx2Sonar</PackageId>
    <RollForward>LatestMajor</RollForward>
    <ToolCommandName>dotnet-trx2sonar</ToolCommandName>
  </PropertyGroup>

  <!-- Packaged as a RID-specific .NET tool (.NET 10+): each listed RID gets a self-contained
       Native AOT package, and `any` is a portable CoreCLR fallback. The CLI picks the right one
       on `dotnet tool install`. PublishAot is passed at pack time (dotnet pack -r RID
       -p:PublishAot=true, on a matching-OS machine; the fallback with dotnet pack -r any
       -p:PublishAot=false) rather than set here, so the default restore stays RID-agnostic and the
       committed lock file works under locked-mode restore on every CI OS. The analyzers below keep
       the build AOT-safe in the meantime. -->
  <PropertyGroup>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrxToSonarTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
